{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sorg",
  "version": "0.1.0",
  "identifier": "dev.nico.sorg",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npx vite --port 1420 --strictPort",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Sorg — スクショ整理",
        "width": 1100,
        "height": 760,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Desktop/**/*", "$HOME/Desktop", "$HOME/Pictures/**/*", "$HOME/Pictures"]
      }
    }
  },
  "bundle": {
    "active": false
  }
}
